\contentsline {figure}{\numberline {V.1}{\ignorespaces \emph {Hallucination rate} per konfigurasi pada sampel uji: (a) \texttt {ABSTAIN} dikeluarkan dari penyebut, (b) \texttt {ABSTAIN} dihitung sebagai kegagalan.}}{99}{figure.caption.62}%
\contentsline {figure}{\numberline {V.2}{\ignorespaces Komposisi label panel per konfigurasi (jawaban faktual, berhalusinasi, dan \texttt {ABSTAIN}).}}{100}{figure.caption.63}%
\contentsline {figure}{\numberline {V.3}{\ignorespaces Kategori halusinasi per konfigurasi. Tinggi bar adalah \emph {hallucination rate} versi (a), terdiri atas halusinasi penuh dan sebagian. Belah ketupat adalah versi (b), yaitu \texttt {ABSTAIN} dihitung sebagai kegagalan (sama dengan versi (a) pada A).}}{101}{figure.caption.65}%
\contentsline {figure}{\numberline {V.4}{\ignorespaces \emph {Hallucination rate} versi (a) pada himpunan bersama $\mathcal {S}$ ($n{=}273$).}}{103}{figure.caption.67}%
\contentsline {figure}{\numberline {V.5}{\ignorespaces Matriks selisih \emph {hallucination rate} versi (a) antarkonfigurasi (poin persentase): (a) seluruh 384 pertanyaan, (b) himpunan bersama $\mathcal {S}$.}}{104}{figure.caption.69}%
\contentsline {figure}{\numberline {V.6}{\ignorespaces \emph {Faithfulness}, \emph {citation support}, \emph {valid citation rate} (seluruh jawaban), dan \emph {context relevance} pada konfigurasi berkonteks.}}{105}{figure.caption.70}%
\contentsline {figure}{\numberline {V.7}{\ignorespaces Rata-rata item \emph {accepted} per konteks dan \emph {hallucination rate} versi (a) pada keempat konfigurasi berkonteks.}}{108}{figure.caption.73}%
\contentsline {figure}{\numberline {V.8}{\ignorespaces Sebaran label (a) relevansi konteks per item dan (b) relevansi jawaban pada konfigurasi berkonteks (persentase).}}{110}{figure.caption.76}%
\contentsline {figure}{\numberline {V.9}{\ignorespaces Latensi rata-rata per kueri (batang) dan median (belah ketupat): (a) total, dengan batas NF3 15 detik, (b) \emph {retrieval}.}}{110}{figure.caption.78}%
\contentsline {figure}{\numberline {V.10}{\ignorespaces Kolam kandidat graf pada 384 pertanyaan uji: (a) jumlah kandidat graf (satu \emph {hop} ditambah dua \emph {hop} setelah pembatasan 50) dan (b) jumlah jawaban \emph {accepted} pada kolam.}}{112}{figure.caption.79}%
