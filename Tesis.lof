\contentsline {figure}{\numberline {V.1}{\ignorespaces \emph {Hallucination rate} per konfigurasi pada sampel uji: (a) \texttt {ABSTAIN} dikeluarkan dari penyebut, (b) \texttt {ABSTAIN} dihitung sebagai kegagalan.}}{101}{figure.caption.64}%
\contentsline {figure}{\numberline {V.2}{\ignorespaces Komposisi label panel per konfigurasi (jawaban faktual, berhalusinasi, dan \texttt {ABSTAIN}).}}{102}{figure.caption.65}%
\contentsline {figure}{\numberline {V.3}{\ignorespaces Kategori halusinasi per konfigurasi. Tinggi bar adalah \emph {hallucination rate} versi (a), terdiri atas halusinasi penuh dan sebagian. Belah ketupat adalah versi (b), yaitu \texttt {ABSTAIN} dihitung sebagai kegagalan (sama dengan versi (a) pada A).}}{103}{figure.caption.67}%
\contentsline {figure}{\numberline {V.4}{\ignorespaces \emph {Hallucination rate} versi (a) pada himpunan bersama $\mathcal {S}$ ($n{=}273$).}}{105}{figure.caption.69}%
\contentsline {figure}{\numberline {V.5}{\ignorespaces Matriks selisih \emph {hallucination rate} versi (a) antarkonfigurasi (selisih, \%): (a) seluruh 384 pertanyaan, (b) himpunan bersama $\mathcal {S}$.}}{106}{figure.caption.71}%
\contentsline {figure}{\numberline {V.6}{\ignorespaces \emph {Faithfulness}, \emph {citation support}, \emph {valid citation rate} (seluruh jawaban), dan \emph {context relevance} pada konfigurasi berkonteks.}}{108}{figure.caption.72}%
\contentsline {figure}{\numberline {V.7}{\ignorespaces Rata-rata item \emph {accepted} per konteks dan \emph {hallucination rate} versi (a) pada keempat konfigurasi berkonteks.}}{111}{figure.caption.75}%
\contentsline {figure}{\numberline {V.8}{\ignorespaces Sebaran label (a) relevansi konteks per item dan (b) relevansi jawaban pada konfigurasi berkonteks (persentase).}}{113}{figure.caption.78}%
\contentsline {figure}{\numberline {V.9}{\ignorespaces Latensi rata-rata per kueri (batang) dan median (belah ketupat): (a) total, dengan batas NF3 15 detik, (b) \emph {retrieval}.}}{114}{figure.caption.80}%
\contentsline {figure}{\numberline {V.10}{\ignorespaces Distribusi kandidat graf pada 384 pertanyaan uji: (a) jumlah kandidat satu dan dua \emph {hop} setelah pembatasan, serta (b) jumlah jawaban \emph {accepted} dalam kumpulan kandidat.}}{115}{figure.caption.81}%
