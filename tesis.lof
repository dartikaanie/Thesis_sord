\contentsline {figure}{\numberline {II.1}{\ignorespaces Contoh kegagalan penalaran akibat ketidaksesuaian waktu informasi dan penggunaan data yang mengandung informasi keliru \blx@tocontentsinit {0}\textcite {Chang2026}}}{15}{figure.caption.11}%
\contentsline {figure}{\numberline {II.2}{\ignorespaces \emph {Inference Pipeline} RAG modular berdasarkan taksonomi \blx@tocontentsinit {0}\autocite {Vizniuk2024}.}}{19}{figure.caption.12}%
\contentsline {figure}{\numberline {II.3}{\ignorespaces Taksonomi RAG yang terdiri atas tahap \emph {Indexing}, \emph {Retrieval}, \emph {Fusion}, dan \emph {Generation} \blx@tocontentsinit {0}\autocite {Kamalipour2026}}}{20}{figure.caption.13}%
\contentsline {figure}{\numberline {II.4}{\ignorespaces Proses pengindeksan pada pipeline RAG: mulai dari pemuatan data (\emph {data loading}), pemotongan teks (\emph {chunking}), pembentukan embedding, hingga penyimpanan dalam basis data vektor (\emph {vector database}). \blx@tocontentsinit {0}\autocite {Kamalipour2026}}}{21}{figure.caption.14}%
\contentsline {figure}{\numberline {II.5}{\ignorespaces Gambaran umum \emph {pipeline} Graph-RAG: ekstraksi triple, penelusuran subgraf (\emph {sub-graph traversal}), serta integrasi hibrida antara representasi vektor dan simbolik.\blx@tocontentsinit {0}\autocite {Kamalipour2026}}}{29}{figure.caption.15}%
\contentsline {figure}{\numberline {II.6}{\ignorespaces Gambaran umum rancangan empiris yang digunakan untuk menguji korelasi antara sinyal kepercayaan komunitas Stack Overflow dengan akurasi jawaban LLM. \blx@tocontentsinit {0}\autocite {DaSilva2025}}}{37}{figure.caption.17}%
\contentsline {figure}{\numberline {II.7}{\ignorespaces Distribusi domain pertanyaan untuk jawaban LLM dengan kemiripan tinggi dan rendah terhadap komunitas Stack Overflow. \blx@tocontentsinit {0}\textcite {DaSilva2025}}}{38}{figure.caption.19}%
\contentsline {figure}{\numberline {II.8}{\ignorespaces Tahapan evaluasi \emph {LLM-as-a-Judge} yang meliputi pemberian konteks, inferensi model penilai, \emph {post-processing}, dan agregasi skor \blx@tocontentsinit {0}\autocite {Gu2026}.}}{43}{figure.caption.21}%
\contentsline {figure}{\numberline {II.9}{\ignorespaces Kerangka konseptual penelitian}}{48}{figure.caption.23}%
\addvspace {10\p@ }
\contentsline {figure}{\numberline {III.1}{\ignorespaces Model konseptual sistem tanya-jawab berbasis LLM generik tanpa mekanisme pengambilan konteks dari sumber terverifikasi.}}{52}{figure.caption.24}%
\contentsline {figure}{\numberline {III.2}{\ignorespaces Matriks komparasi tiga kondisi evaluasi terhadap sembilan kriteria kebutuhan sistem. Kondisi A (LLM Murni) merupakan \emph {baseline} \blx@tocontentsinit {0}\autocite {DaSilva2025}, Kondisi B (RAG Konvensional) merupakan \emph {ablation study}, dan Kondisi C (\emph {GraphRAG Framework}) merupakan solusi yang diusulkan. Ketiga kondisi akan dievaluasi menggunakan dataset yang sama dengan metrik yang kompatibel terhadap hasil yang dilaporkan oleh \blx@tocontentsinit {0}\textcite {DaSilva2025}.}}{59}{figure.caption.29}%
\contentsline {figure}{\numberline {III.3}{\ignorespaces Arsitektur \emph {GraphRAG Framework} berdasarkan kerangka konseptual empat jalur dari Bab~\ref {chap:studi-literatur}. Label G1--G3 menunjukkan kesenjangan yang dijawab oleh setiap komponen.}}{59}{figure.caption.30}%
\contentsline {figure}{\numberline {III.4}{\ignorespaces Contoh subgraf \emph {knowledge graph} berbobot dari dataset SORD pada domain Python. Setiap sisi graf dilengkapi dengan bobot kepercayaan komunitas Stack Overflow ($w$) yang dikodekan secara eksplisit, meliputi bobot \texttt {hasAcceptedAnswer} ($w = 1{,}0$), \texttt {hasAnswer} ($w = \text {normalize}(\texttt {score})$), dan \texttt {isRelatedTo} ($w = \text {similarity}(q_i, q_j)$) dari pasangan rekomendasi SORD.}}{61}{figure.caption.32}%
\contentsline {figure}{\numberline {III.5}{\ignorespaces Flowchart konstruksi \emph {knowledge graph} berbobot dari dataset SORD.}}{62}{figure.caption.33}%
\contentsline {figure}{\numberline {III.6}{\ignorespaces Flowchart alur pemrosesan kueri pada \emph {GraphRAG Framework}. Moda 1 digunakan ketika entitas kueri dapat dipetakan ke KG; Moda 2 digunakan sebagai \emph {fallback}.}}{63}{figure.caption.34}%
